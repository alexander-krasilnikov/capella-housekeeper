# One entry per Capella organization to monitor. "orgName" is optional -
# sync fetches the real org name from the API on every cycle; it's only
# used as a fallback label if that call fails.
CAPELLA_ORGS=[{"orgId":"00000000-0000-0000-0000-000000000000","apiKey":"REPLACE_ME"}]

# Optional: override the Capella Management API base URL.
# CAPELLA_API_BASE_URL=https://cloudapi.cloud.couchbase.com/v4

# How often the background sync process polls Capella, in milliseconds.
SYNC_INTERVAL_MS=300000

# How many days to keep a deleted cluster's tombstone + history before purging.
RETENTION_DAYS=7

# Where the local JSON store lives on disk.
DATA_DIR=./data

# Dashboard login (single shared credential for this phase).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
